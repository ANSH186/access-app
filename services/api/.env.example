# Copy to .env for local development. Never commit real keys.
ENV=development
# Local dev only. Refused (ignored) when ENV=production.
DEV_AUTH=1

SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Optional: public/publishable key used as PostgREST apikey when the API falls
# back to reading the map over REST. A safe default is built in.
SUPABASE_PUBLIC_KEY=
# Optional: legacy HS256 JWT secret (Project Settings > API). If empty, tokens are verified via JWKS.
SUPABASE_JWT_SECRET=
# Supabase SESSION POOLER connection string (IPv4), e.g.
# postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.8-flash,gemini-flash-latest
GEMINI_TIMEOUT_S=45
# Independent sign-reading fallback. "helloworld" is rate-limited; get a free key.
OCR_SPACE_API_KEY=helloworld

# Additional outdoor campus graph merged into the database map.
CAMPUS_MAP_ENABLED=1
CAMPUS_MAP_PATH=app/data/nie_north_campus.json

# Comma-separated list of allowed web origins (admin dashboard). Empty = allow all in development.
CORS_ORIGINS=http://localhost:5173

# "db" (default) or "file:<path to lab_block.json>" for local development without a database.
MAP_SOURCE=db
