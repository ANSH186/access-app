# AccessAble AI - Root Environment Example
# Copy this file to .env for local Docker Compose and API development.
# NEVER commit .env or real credentials to version control.

# Environment mode: development or production
ENV=development

# Port to bind for API service (default: 8000)
PORT=8000

# Enable local development authentication bypass (REFUSED if ENV=production)
DEV_AUTH=1

# Supabase Project Configuration
SUPABASE_URL=https://your-project-id.supabase.co
# Public publishable key for PostgREST client fallback
SUPABASE_PUBLIC_KEY=your-supabase-anon-or-publishable-key
# Legacy JWT secret (optional; JWKS endpoint is used by default)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
# Direct PostgreSQL connection or session pooler URL (IPv4)
# Example: postgresql://postgres.your-ref:your-password@aws-0-region.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Google Gemini AI Configuration
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.8-flash,gemini-flash-latest
GEMINI_TIMEOUT_S=45

# OCR.space fallback key (optional, 'helloworld' provided for testing)
OCR_SPACE_API_KEY=helloworld

# Campus Map Configuration
CAMPUS_MAP_ENABLED=1
CAMPUS_MAP_PATH=app/data/nie_north_campus.json
# Map source: "db" (reads from Supabase) or "file:<path>" (local JSON map)
MAP_SOURCE=db

# Allowed CORS Origins (comma-separated). Empty or "*" allows all in development.
CORS_ORIGINS=http://localhost:5173,http://localhost:8081
